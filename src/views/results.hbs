            <th>Key Findings</th>
          </tr>
        </thead>
        <tbody>
          <tr class="highlight-row">
            <td><strong>Gradient Boosting</strong></td>
            <td>Supervised (Ensemble)</td>
            <td>Round Winner Prediction</td>
